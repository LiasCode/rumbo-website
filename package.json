		"astro": "astro",
		"pages": "bun scripts/check-pages.ts"
	},
	"dependencies": {
		"astro": "7.4.13"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@types/bun": "^1.4.5",
		"oxfmt": "0.80.0",
		"oxlint": "1.95.0",
		"typescript": "6"
	}
}
