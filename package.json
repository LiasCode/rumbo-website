{
	"name": "rumbo-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"verify": "bun run format:check && bun run lint && bun run check && bun run build && bun run pages",
