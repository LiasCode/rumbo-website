---
import type { Locale } from '../navigation';

// A conversation between two or three programs, drawn as lanes and the
// frames that cross them, which redraw themselves one after the other for
// as long as the page is open, the one crossing in red. The articles that
// have one are named here, with the frames their protocol really has; an
// answer is drawn dashed.
const { locale, slug, number = 1 } = Astro.props as { locale: Locale; slug: string; number?: number };

const words = {
	en: { host: 'Host', provider: 'Provider', frontend: 'Front end', extension: 'Extension', bridge: 'rumbo extend mcp', server: 'MCP server', you: 'You', rumbo: 'rumbo', plugin: 'Plugin', label: 'Sequence of frames', caption: 'The frames, in the order they cross. An answer is dashed; the one in red is crossing now.' },
	es: { host: 'Host', provider: 'Proveedor', frontend: 'Interfaz', extension: 'Extensión', bridge: 'rumbo extend mcp', server: 'Servidor MCP', you: 'Tú', rumbo: 'rumbo', plugin: 'Plugin', label: 'Secuencia de mensajes', caption: 'Los mensajes, en el orden en que cruzan. Una respuesta va discontinua; el de rojo es el que cruza ahora.' },
	fr: { host: 'Hôte', provider: 'Fournisseur', frontend: 'Interface', extension: 'Extension', bridge: 'rumbo extend mcp', server: 'Serveur MCP', you: 'Vous', rumbo: 'rumbo', plugin: 'Plugin', label: 'Séquence de messages', caption: 'Les messages, dans l’ordre où ils passent. Une réponse est en pointillés ; celui en rouge passe en ce moment.' },
	it: { host: 'Host', provider: 'Provider', frontend: 'Interfaccia', extension: 'Estensione', bridge: 'rumbo extend mcp', server: 'Server MCP', you: 'Tu', rumbo: 'rumbo', plugin: 'Plugin', label: 'Sequenza di messaggi', caption: 'I messaggi, nell’ordine in cui passano. Una risposta è tratteggiata; quello in rosso sta passando ora.' },
}[locale];

type Step = [from: number, to: number, label: string, answer?: boolean];

const provider: Step[] = [
	[0, 1, 'initialize { protocol, config }'],
	[1, 0, '{ protocol, name, model, options, functions }', true],
	[0, 1, 'complete { model, system, messages, tools }'],
	[1, 0, 'delta { id, text }'],
	[1, 0, '{ message, stop, usage }', true],
	[0, 1, 'cancel { id }'],
	[0, 1, 'shutdown'],
];

const frontend: Step[] = [
	[1, 0, 'initialize { protocol, dir, provider, model }'],
	[0, 1, '{ protocol, name }', true],
	[0, 1, 'describe'],
	[0, 1, 'run { objective }'],
	[1, 0, 'event { type: "text" | "tool_started" | … }'],
	[0, 1, 'steer { text }'],
	[1, 0, 'ask { text, secret }'],
	[0, 1, '{ text }', true],
	[1, 0, '{ status, session }', true],
];

const extension: Step[] = [
	[0, 1, 'initialize { protocol, config }'],
	[1, 0, '{ protocol, name, tools, sections, events, functions }', true],
	[0, 1, 'section { name, dir }'],
	[1, 0, '{ text }', true],
	[0, 1, 'call { name, args, dir, session }'],
	[1, 0, 'call { id, name: "bash", args }'],
	[0, 1, '{ text, is_error }', true],
	[1, 0, '{ text, images, is_error }', true],
	[0, 1, 'event { type: "ended" }'],
];

const diagrams: Record<string, { lanes: string[]; steps: Step[] }> = {
	'reference/provider-protocol': { lanes: [words.host, words.provider], steps: provider },
	'extend/provider': { lanes: [words.host, words.provider], steps: provider },
	'reference/frontend-protocol': { lanes: [words.frontend, words.host], steps: frontend },
	'extend/front-end': { lanes: [words.frontend, words.host], steps: frontend },
	'reference/extension-protocol': { lanes: [words.host, words.extension], steps: extension },
	'extend/extension': { lanes: [words.host, words.extension], steps: extension },
	'guides/extensions': {
		lanes: [words.host, words.bridge, words.server],
		steps: [
			[0, 1, 'initialize'],
			[1, 2, 'initialize'],
			[1, 2, 'tools/list'],
			[1, 0, '{ tools }', true],
			[0, 1, 'call { name, args }'],
			[1, 2, 'tools/call'],
			[2, 1, '{ content }', true],
			[1, 0, '{ text }', true],
		],
	},
	'guides/plugins': {
		lanes: [words.you, words.rumbo, words.plugin],
		steps: [
			[0, 1, 'rumbo plugin add <source>'],
			[1, 2, 'git clone · or read the folder'],
			[2, 1, 'plugin.yaml', true],
			[1, 2, 'build'],
			[1, 2, 'initialize'],
			[2, 1, '{ protocol, name, … }', true],
			[1, 0, 'added'],
		],
	},
};

diagrams['reference/plugins'] = diagrams['guides/plugins'];

const { lanes, steps } = diagrams[slug];
// Each frame takes this long to be drawn, and the whole drawing goes round
// once all of them have had their turn.
const beat = 1.15;
const round = steps.length * beat;
const drawn = ((0.75 / round) * 100).toFixed(2);
const turn = ((beat / round) * 100).toFixed(2);
const name = `sequence-${slug.replace('/', '-')}`;
const percent = (value: number) => `${((value / lanes.length) * 100).toFixed(3)}%`;
---

<figure class="figure sequence" aria-label={words.label} style={`--round:${round}s;--beat:${beat}s;--act:${name}-act`}>
	<ol class="lanes" aria-hidden="true">{lanes.map((lane) => <li><span>{lane}</span></li>)}</ol>
	<div class="track">
		{lanes.map((_, lane) => <i class="lifeline" style={`left:${percent(lane + 0.5)}`}></i>)}
		<ol class="steps">
			{steps.map(([from, to, label, answer], index) => (
				<li class:list={[to < from ? 'leftward' : 'rightward', { answer }]} style={`--order:${index};--left:${percent(Math.min(from, to) + 0.5)};--span:${percent(Math.abs(to - from))}`}>
					<code><span class="who">{lanes[from]} → {lanes[to]}: </span>{label}</code>
					<span class="arrow" aria-hidden="true"></span>
				</li>
			))}
		</ol>
	</div>
	<figcaption><b>Fig. {number} ·</b> {words.caption}</figcaption>
</figure>

<style is:inline set:html={`
@keyframes ${name}-act { 0% { transform: scaleX(0); opacity: 1; } ${drawn}% { transform: scaleX(1); opacity: 1; } ${turn}% { transform: scaleX(1); opacity: 1; } ${(Number(turn) + 2).toFixed(2)}%, 100% { transform: scaleX(1); opacity: 0; } }
`}></style>

<style>
	.lanes,
	.steps {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.lanes {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: 1ch;
	}

	.lanes li {
		text-align: center;
	}

	.lanes span {
		display: inline-block;
		max-width: 100%;
		padding: 0.2lh 1.5ch;
		border: 1.5px solid var(--ink);
		font-weight: 800;
		overflow-wrap: anywhere;
	}

	.track {
		position: relative;
		padding: 0.5lh 0 0.2lh;
	}

	.lifeline {
		position: absolute;
		top: 0;
		bottom: 0;
		border-left: 1px dashed var(--dim);
	}

	.steps li {
		position: relative;
		padding-bottom: 0.9lh;
	}

	/* The label of the frame, over its arrow, on paper so the lifelines
	   pass behind it. */
	.steps code {
		position: relative;
		display: block;
		width: fit-content;
		max-width: 100%;
		margin: 0 auto;
		padding: 0 1ch;
		background: var(--paper);
		font-weight: 400;
		font-size: 0.875rem;
		text-align: center;
		overflow-wrap: anywhere;
	}

	/* The arrow: a line from one lane to the other, solid for a request and
	   dashed for an answer, and a head where it points. */
	.arrow {
		position: absolute;
		bottom: 0.45lh;
		left: var(--left);
		width: var(--span);
		border-top: 1.5px solid var(--ink);
	}

	.answer .arrow {
		border-top-style: dashed;
	}

	.arrow::after {
		content: '';
		position: absolute;
		top: calc(-0.35em - 0.75px);
		right: -1px;
		width: 0.6em;
		height: 0.7em;
		background: var(--ink);
		clip-path: polygon(0 0, 100% 50%, 0 100%);
	}

	.leftward .arrow::after {
		right: auto;
		left: -1px;
		clip-path: polygon(100% 0, 0 50%, 100% 100%);
	}

	/* The frame crossing now: the same line in red, drawn over it in its
	   turn, and gone when the next one starts. */
	.arrow::before {
		content: '';
		position: absolute;
		top: -2px;
		left: 0;
		right: 0;
		border-top: 2.5px solid var(--red);
		transform-origin: left;
		opacity: 0;
		animation: var(--act) var(--round) calc(var(--order) * var(--beat)) linear infinite backwards;
	}

	.leftward .arrow::before {
		transform-origin: right;
	}

	/* Who speaks to whom is in the arrow; it is said in words for those who
	   do not see it, and shown when there is no room for lanes. */
	.who {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@container (max-width: 30rem) {
		.lanes,
		.lifeline {
			display: none;
		}

		.track {
			padding-top: 0;
		}

		.steps code {
			margin: 0;
			padding: 0;
			text-align: left;
		}

		.who {
			position: static;
			display: block;
			width: auto;
			height: auto;
			overflow: visible;
			clip-path: none;
			color: var(--dim);
			white-space: normal;
		}

		.arrow {
			left: 0;
			width: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.arrow::before {
			animation: none;
		}
	}
</style>
