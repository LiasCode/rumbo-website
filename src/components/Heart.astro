---
import { href, type Locale } from '../navigation';
import { arc, brush, cubic, hairs, line, pressed, spatter, type Point } from './ink';

// The cover drawing: an ensō, the circle a brush leaves open, around the
// host's seal, and three chains that leave through it and run off the
// sheet, since what they reach is not part of rumbo.
const { locale } = Astro.props as { locale: Locale };
const [title, ...names] = {
	en: ['The rumbo host, and the three protocols that leave it', 'Front ends', 'Providers', 'Extensions'],
	es: ['El host de rumbo y los tres protocolos que salen de él', 'Interfaces', 'Proveedores', 'Extensiones'],
	fr: ['L’hôte rumbo et les trois protocoles qui en partent', 'Interfaces', 'Fournisseurs', 'Extensions'],
	it: ['L’host di rumbo e i tre protocolli che ne escono', 'Interfacce', 'Provider', 'Estensioni'],
}[locale];

const size = 500;
const heart: Point = [250, 256];
const enso = arc(heart, 176, -62, 334, 8);
const chains = [
	{ name: names[0], path: 'extend/front-end', tag: [16, 96] as Point, route: cubic([196, 250], [120, 236], [96, 150], [-40, 132]) },
	{ name: names[1], path: 'extend/provider', tag: [330, 34] as Point, route: cubic([292, 214], [352, 176], [398, 96], [540, 70]) },
	{ name: names[2], path: 'extend/extension', tag: [322, 436] as Point, route: cubic([296, 300], [372, 330], [420, 424], [540, 468]) },
].map((chain) => ({ ...chain, d: line(chain.route) }));
---

<a class="heart-art" href={href(locale, 'reference/architecture')} aria-label={title}>
	<svg viewBox={`0 0 ${size} ${size}`} aria-hidden="true">
		<defs>
			<mask id="heart-enso" maskUnits="userSpaceOnUse" x="0" y="0" width={size} height={size}>
				<path class="sweep" d={line(enso)} pathLength="1" stroke="#fff" stroke-width="92" fill="none" />
			</mask>
			{chains.map(({ d }, index) => (
				<mask id={`heart-chain-${index}`} maskUnits="userSpaceOnUse" x="-60" y="0" width={size + 120} height={size}>
					<path class="sweep" style={`--after:${1.5 + index * 0.25}s`} d={d} pathLength="1" stroke="#fff" stroke-width="30" fill="none" />
				</mask>
			))}
		</defs>

		<g mask="url(#heart-enso)">
			<path class="ink" d={brush(enso, pressed(52), 3, 0.2)} />
			{hairs(enso, 40, 9, 9).map((hair) => <path class="hair" d={hair} />)}
		</g>
		{spatter(heart, 205, 21, 11).map(({ x, y, r }, index) => <circle class="drop" style={`--after:${0.5 + index * 0.07}s`} cx={x} cy={y} {r} />)}

		{chains.map(({ d }, index) => (
			<g class="chain">
				<g mask={`url(#heart-chain-${index})`}>
					<path class="link" {d} />
					<path class="hole" {d} />
					<path class="pin" {d} />
				</g>
				<circle class="signal out" r="6" style={`offset-path:path('${d}');--after:${2.2 + index * 0.5}s`} />
				<circle class="signal back" r="4.5" style={`offset-path:path('${d}');--after:${3.6 + index * 0.5}s`} />
			</g>
		))}

		<circle class="beat" cx={heart[0]} cy={heart[1]} r="78" />
		<circle class="beat late" cx={heart[0]} cy={heart[1]} r="78" />
		<g class="seal">
			<rect x={heart[0] - 74} y={heart[1] - 62} width="148" height="124" rx="4" />
			<text class="seal-kind" x={heart[0] - 58} y={heart[1] - 32}>HOST / 00</text>
			<text class="seal-name" x={heart[0]} y={heart[1] + 26} text-anchor="middle">rumbo</text>
		</g>

		{chains.map(({ name, tag }, index) => (
			<g class="tag" style={`--after:${2 + index * 0.25}s`}>
				<rect x={tag[0]} y={tag[1]} width="152" height="34" rx="2" />
				<text x={tag[0] + 12} y={tag[1] + 22.5}><tspan class="tag-index">0{index + 1}</tspan> {name}</text>
			</g>
		))}
	</svg>
</a>

<style>
	.heart-art {
		display: block;
		width: 100%;
		min-width: 0;
		max-width: 36rem;
		margin-inline: auto;
	}

	svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.ink {
		fill: var(--ink);
	}

	.hair {
		fill: none;
		stroke: var(--paper);
		stroke-width: 1.5;
		opacity: 0.7;
	}

	.sweep {
		stroke-dasharray: 1;
		animation: sweep 1.5s var(--after, 0.15s) cubic-bezier(0.6, 0, 0.2, 1) both;
	}

	.chain .sweep {
		animation-duration: 0.9s;
	}

	.drop {
		fill: var(--ink);
		transform-box: fill-box;
		transform-origin: center;
		animation: land 0.35s var(--after) cubic-bezier(0.2, 1.6, 0.4, 1) both;
	}

	.chain path {
		fill: none;
		stroke-linecap: round;
		stroke-dasharray: 10 11;
		animation: run 1.3s linear infinite;
	}

	.link {
		stroke: var(--ink);
		stroke-width: 7;
	}

	.hole {
		stroke: var(--paper);
		stroke-width: 2.8;
	}

	.chain .pin {
		stroke: var(--ink);
		stroke-width: 1.8;
		stroke-dasharray: 9 12;
		stroke-dashoffset: -11;
		animation-name: run-pin;
	}

	.signal {
		fill: var(--seal);
		opacity: 0;
		animation: go 2.8s var(--after) cubic-bezier(0.45, 0, 0.25, 1) infinite;
	}

	.signal.back {
		fill: var(--ink);
		stroke: var(--paper);
		stroke-width: 2;
		animation-direction: reverse;
	}

	.seal {
		transform-box: fill-box;
		transform-origin: center;
		transform: rotate(-5deg);
		animation: stamp 0.5s 1.05s cubic-bezier(0.2, 1.3, 0.4, 1) both;
	}

	.seal rect {
		fill: var(--seal);
		transform-box: fill-box;
		transform-origin: center;
		animation: throb 2.6s 1.8s ease-in-out infinite;
	}

	.seal-kind {
		fill: #ffe9dc;
		font: 600 13px var(--mono);
		letter-spacing: 0.16em;
	}

	.seal-name {
		fill: #fff7ee;
		font: 900 47px var(--sans);
		letter-spacing: -0.075em;
	}

	.beat {
		fill: none;
		stroke: var(--seal);
		stroke-width: 2.5;
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
		animation: beat 2.6s 1.8s ease-out infinite;
	}

	.beat.late {
		animation-delay: 2.25s;
	}

	.tag {
		transform-box: fill-box;
		transform-origin: center;
		animation: land 0.45s var(--after) cubic-bezier(0.2, 1.4, 0.4, 1) both;
	}

	.tag rect {
		fill: var(--ink);
	}

	.tag text {
		fill: var(--surface);
		font: 700 15.5px var(--sans);
	}

	.tag-index {
		fill: #ff8a66;
		font: 12px var(--mono);
	}

	@keyframes sweep {
		from {
			stroke-dashoffset: 1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes land {
		from {
			opacity: 0;
			transform: scale(0.3);
		}
	}

	@keyframes stamp {
		from {
			opacity: 0;
			transform: rotate(-11deg) scale(1.7);
		}
	}

	@keyframes throb {
		0%,
		24%,
		100% {
			transform: scale(1);
		}
		8% {
			transform: scale(1.06);
		}
		16% {
			transform: scale(0.985);
		}
	}

	@keyframes beat {
		0% {
			opacity: 0.7;
			transform: scale(1);
		}
		70%,
		100% {
			opacity: 0;
			transform: scale(2.3);
		}
	}

	@keyframes run {
		to {
			stroke-dashoffset: -21;
		}
	}

	@keyframes run-pin {
		to {
			stroke-dashoffset: -32;
		}
	}

	@keyframes go {
		0% {
			offset-distance: 2%;
			opacity: 0;
		}
		10%,
		62% {
			opacity: 1;
		}
		74%,
		100% {
			offset-distance: 78%;
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		svg * {
			animation: none !important;
		}
	}
</style>
