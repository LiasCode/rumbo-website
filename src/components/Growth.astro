---
import { href, type Locale } from '../navigation';

// The whole of rumbo as one drawing that grows: the host in the middle, the
// three protocols above it, what it keeps in files below, and what people
// build with each. compact leaves what they build out, for the articles.
const { locale, compact = false, number = 1 } = Astro.props as { locale: Locale; compact?: boolean; number?: number };

const copy = {
	en: {
		title: 'From the heart outwards',
		summary: 'The host is small. Everything else grows from three protocols, a log, and plain files.',
		play: 'Play',
		pause: 'Pause',
		position: 'Position in the drawing',
		organs: ['agent loop', 'read · write · edit · bash', 'append-only log'],
		branches: [
			['Front ends', 'Agent Frontend Protocol', ['Terminal UI', 'Plain output for scripts', 'Desktop app', 'Inside your editor', 'Yours: a bot, a web page']],
			['Providers', 'Agent Provider Protocol', ['Claude API', 'OpenAI APIs', 'A ChatGPT plan', 'Local: Ollama, llama.cpp, vLLM', 'Yours: any model']],
			['Extensions', 'Agent Extension Protocol', ['MCP servers', 'Tools of your own', 'A guarded or sandboxed bash', 'Context: notes, memory', 'Listeners: notify, count cost', 'Commands such as /login docs']],
			['Sessions', 'entries.jsonl', ['Continue and resume', 'Branch before any message', 'Replay the exact request', 'Compaction near the limit', 'Export as Markdown']],
			['Instructions', 'AGENTS.md · SKILL.md', ['Your guide, everywhere', 'A guide for each project', 'Skills, read when needed']],
			['Plugins', 'plugin.yaml', ['All of it in one package', 'From Git or a folder', 'Built when installed', 'Consent to replace a tool']],
		],
	},
	es: {
		title: 'Del corazón hacia fuera',
		summary: 'El host es pequeño. Todo lo demás crece a partir de tres protocolos, un registro y archivos de texto.',
		play: 'Reproducir',
		pause: 'Pausar',
		position: 'Posición en el dibujo',
		organs: ['bucle del agente', 'read · write · edit · bash', 'registro de solo anexar'],
		branches: [
			['Interfaces', 'Agent Frontend Protocol', ['Interfaz de terminal', 'Texto plano para scripts', 'Aplicación de escritorio', 'Dentro de tu editor', 'La tuya: un bot, una web']],
			['Proveedores', 'Agent Provider Protocol', ['API de Claude', 'APIs de OpenAI', 'Un plan de ChatGPT', 'Local: Ollama, llama.cpp, vLLM', 'El tuyo: cualquier modelo']],
			['Extensiones', 'Agent Extension Protocol', ['Servidores MCP', 'Herramientas propias', 'Un bash vigilado o aislado', 'Contexto: notas, memoria', 'Oyentes: avisar, contar coste', 'Comandos como /login docs']],
			['Sesiones', 'entries.jsonl', ['Continuar y reanudar', 'Ramificar antes de un mensaje', 'Repetir la petición exacta', 'Compactar cerca del límite', 'Exportar a Markdown']],
			['Instrucciones', 'AGENTS.md · SKILL.md', ['Tu guía, en todas partes', 'Una guía por proyecto', 'Skills, leídas al necesitarse']],
			['Plugins', 'plugin.yaml', ['Todo en un solo paquete', 'Desde Git o una carpeta', 'Se compila al instalar', 'Permiso para sustituir']],
		],
	},
	fr: {
		title: 'Du cœur vers l’extérieur',
		summary: 'L’hôte est petit. Tout le reste pousse à partir de trois protocoles, d’un journal et de fichiers texte.',
		play: 'Lire',
		pause: 'Pause',
		position: 'Position dans le dessin',
		organs: ['boucle de l’agent', 'read · write · edit · bash', 'journal en ajout seul'],
		branches: [
			['Interfaces', 'Agent Frontend Protocol', ['Interface en terminal', 'Texte brut pour les scripts', 'Application de bureau', 'Dans votre éditeur', 'La vôtre : un bot, une page']],
			['Fournisseurs', 'Agent Provider Protocol', ['API de Claude', 'API d’OpenAI', 'Une offre ChatGPT', 'Local : Ollama, llama.cpp, vLLM', 'Le vôtre : tout modèle']],
			['Extensions', 'Agent Extension Protocol', ['Serveurs MCP', 'Vos propres outils', 'Un bash surveillé ou isolé', 'Contexte : notes, mémoire', 'Écoute : notifier, compter', 'Commandes comme /login docs']],
			['Sessions', 'entries.jsonl', ['Continuer et reprendre', 'Bifurquer avant un message', 'Rejouer la requête exacte', 'Compacter près de la limite', 'Exporter en Markdown']],
			['Instructions', 'AGENTS.md · SKILL.md', ['Votre guide, partout', 'Un guide par projet', 'Skills, lus au besoin']],
			['Plugins', 'plugin.yaml', ['Le tout en un paquet', 'Depuis Git ou un dossier', 'Compilé à l’installation', 'Accord pour remplacer']],
		],
	},
	it: {
		title: 'Dal cuore verso l’esterno',
		summary: 'L’host è piccolo. Tutto il resto cresce da tre protocolli, un registro e file di testo.',
		play: 'Riproduci',
		pause: 'Pausa',
		position: 'Posizione nel disegno',
		organs: ['ciclo dell’agente', 'read · write · edit · bash', 'registro in sola aggiunta'],
		branches: [
			['Interfacce', 'Agent Frontend Protocol', ['Interfaccia da terminale', 'Testo semplice per gli script', 'Applicazione desktop', 'Dentro il tuo editor', 'La tua: un bot, una pagina']],
			['Provider', 'Agent Provider Protocol', ['API di Claude', 'API di OpenAI', 'Un piano ChatGPT', 'Locale: Ollama, llama.cpp, vLLM', 'Il tuo: qualsiasi modello']],
			['Estensioni', 'Agent Extension Protocol', ['Server MCP', 'Strumenti tuoi', 'Un bash sorvegliato o isolato', 'Contesto: note, memoria', 'Ascolto: notifiche, costi', 'Comandi come /login docs']],
			['Sessioni', 'entries.jsonl', ['Continuare e riprendere', 'Diramare prima di un messaggio', 'Ripetere la richiesta esatta', 'Compattare vicino al limite', 'Esportare in Markdown']],
			['Istruzioni', 'AGENTS.md · SKILL.md', ['La tua guida, ovunque', 'Una guida per progetto', 'Skill, lette al bisogno']],
			['Plugin', 'plugin.yaml', ['Tutto in un pacchetto', 'Da Git o da una cartella', 'Compilato all’installazione', 'Consenso per sostituire']],
		],
	},
}[locale];

// The page each branch's plate opens, and the page of each of its leaves.
const pages = [
	{ path: 'extend/front-end', leaves: ['guides/terminal-ui', 'guides/scripting', 'guides/desktop-app', 'extend/front-end', 'extend/front-end'] },
	{ path: 'extend/provider', leaves: ['guides/providers', 'guides/providers', 'guides/providers', 'guides/providers', 'extend/provider'] },
	{ path: 'extend/extension', leaves: ['guides/extensions', 'extend/extension', 'reference/extension-protocol', 'reference/extension-protocol', 'reference/extension-protocol', 'guides/extensions'] },
	{ path: 'guides/sessions', leaves: ['guides/sessions', 'guides/sessions', 'guides/sessions', 'guides/sessions', 'guides/sessions'] },
	{ path: 'guides/instructions-and-skills', leaves: ['guides/instructions-and-skills', 'guides/instructions-and-skills', 'guides/instructions-and-skills'] },
	{ path: 'guides/plugins', leaves: ['reference/plugins', 'guides/plugins', 'reference/plugins', 'guides/plugins'] },
];

// The sheet is three columns. The first three branches stand above the
// host with their leaves over them; the other three hang below it.
const width = 780;
const middle = width / 2;
const columns = [130, 390, 650];
const plate = { width: 224, height: 56 };
const host = { width: 268, height: 108 };
const leafStep = 22;
const reach = 60;
const share = (value: number) => value.toFixed(3);
const most = (branches: typeof copy.branches) => (compact ? 0 : Math.max(...branches.map(([, , leaves]) => leaves.length)));

const above = most(copy.branches.slice(0, 3));
const below = most(copy.branches.slice(3));
const top = 14 + (above ? above * leafStep + 10 : 0);
const hostTop = top + plate.height + reach;
const bottom = hostTop + host.height + reach;
const height = bottom + plate.height + (below ? below * leafStep + 10 : 0) + 14;

const branches = copy.branches.map(([name, caption, leaves], index) => {
	const up = index < 3;
	const column = index % 3;
	const x = columns[column] - plate.width / 2;
	const y = up ? top : bottom;
	// The line leaves the host from its own place on the host's edge, turns
	// once halfway, and meets the plate in the middle of its edge.
	const from = [middle + (column - 1) * 70, up ? hostTop : hostTop + host.height];
	const to = [columns[column], up ? y + plate.height : y];
	const turn = (from[1] + to[1]) / 2;
	const start = 0.12 + index * 0.13;
	const spine = x + 14;
	const edge = up ? y : y + plate.height;
	const list = leaves as string[];
	const placed = list.map((label, leaf) => ({
		label,
		href: href(locale, pages[index].leaves[leaf]),
		y: up ? edge - 10 - (list.length - leaf) * leafStep + leafStep / 2 : edge + 10 + leaf * leafStep + leafStep / 2,
		span: `${share(start + 0.07 + leaf * 0.008)} ${share(start + 0.1 + leaf * 0.008)}`,
	}));
	const far = up ? placed[0]?.y : placed.at(-1)?.y;

	return {
		name: name as string,
		caption: caption as string,
		href: href(locale, pages[index].path),
		x,
		y,
		connector: `M${from[0]} ${from[1]}V${turn}H${to[0]}V${to[1]}`,
		tree: far === undefined ? '' : `M${spine} ${edge}V${far}${placed.map(({ y }) => `M${spine} ${y}h9`).join('')}`,
		spine,
		leaves: placed,
		spans: { connector: `${share(start)} ${share(start + 0.04)}`, plate: `${share(start + 0.03)} ${share(start + 0.07)}`, tree: `${share(start + 0.06)} ${share(start + 0.1)}` },
	};
});
---

<ink-growth class:list={[{ compact }]} data-play={copy.play} data-pause={copy.pause}>
	<figure class="figure" aria-label={copy.title}>
		<svg class="drawing wide" viewBox={`0 0 ${width} ${height}`} role="group" aria-label={copy.title}>
			{branches.map(({ connector, tree, spans }, index) => (
				<g class="branch" data-branch={index}>
					<path class="wire draw" data-span={spans.connector} d={connector} pathLength="1" />
					{!compact && tree && <path class="wire draw" data-span={spans.tree} d={tree} pathLength="1" />}
				</g>
			))}

			<a href={href(locale, 'reference/architecture')}>
				<g class="press" data-span="0 0.08">
					<rect class="box" x={middle - host.width / 2} y={hostTop} width={host.width} height={host.height} />
					<rect class="inner" x={middle - host.width / 2 + 4} y={hostTop + 4} width={host.width - 8} height={host.height - 8} />
					<text class="name" x={middle} y={hostTop + 30} text-anchor="middle">rumbo</text>
				</g>
			</a>
			{copy.organs.map((organ, index) => (
				<text class="settle" data-span={`${share(0.05 + index * 0.02)} ${share(0.11 + index * 0.02)}`} x={middle} y={hostTop + 54 + index * 19} text-anchor="middle">{organ}</text>
			))}

			{branches.map(({ name, caption, href, x, y, leaves }, index) => (
				<g class="branch" data-branch={index}>
					<a href={href}>
						<g class="press" data-span={branches[index].spans.plate}>
							<rect class="box" {x} {y} width={plate.width} height={plate.height} />
							<text x={x + 12} y={y + 23}>0{index + 1}</text>
							<text class="name" x={x + 40} y={y + 23}>{name}</text>
							<text x={x + 12} y={y + 44}>{caption}</text>
						</g>
					</a>
					{!compact && leaves.map(({ label, href, y, span }) => (
						<a class="leaf settle" data-span={span} {href}>
							<text x={branches[index].spine + 15} y={y + 4.5}>{label}</text>
						</a>
					))}
				</g>
			))}
		</svg>

		<ol class="growth-list">
			<li class="settle" data-span="0 0.12"><a href={href(locale, 'reference/architecture')}><b>rumbo</b></a> <span>{copy.organs.join(' · ')}</span></li>
			{branches.map(({ name, caption, href, spans, leaves }, index) => (
				<li class="branch" data-branch={index}>
					<a class="settle" data-span={spans.plate} {href}><span>0{index + 1}</span> <b>{name}</b></a>
					<span class="caption settle" data-span={spans.plate}>{caption}</span>
					{!compact && <ul>{leaves.map(({ label, href, span }) => <li class="settle" data-span={span}><a {href}>{label}</a></li>)}</ul>}
				</li>
			))}
		</ol>

		<div class="growth-controls" hidden>
			<button type="button" class="control" data-toggle><span class="when-off">{copy.play}</span><span class="when-on">{copy.pause}</span></button>
			<input type="range" min="0" max="1000" value="1000" aria-label={copy.position} />
		</div>

		<figcaption><b>Fig. {number} ·</b> {copy.summary}</figcaption>
	</figure>
</ink-growth>

<script>
	import { reducedMotion, spans, whenSeen } from './timeline';

	// How long the drawing takes to grow by itself, in milliseconds.
	const length = 11000;

	// Which branch is growing at a point of the drawing, as its spans say:
	// branch n takes from 0.12 + 0.13 n, for 0.13.
	const growing = (progress: number) => (progress >= 1 ? -1 : Math.min(5, Math.floor((progress - 0.12) / 0.13)));

	class InkGrowth extends HTMLElement {
		connectedCallback() {
			const show = spans(this);
			const toggle = this.querySelector<HTMLButtonElement>('[data-toggle]')!;
			const range = this.querySelector<HTMLInputElement>('input')!;
			const branches = [...this.querySelectorAll<HTMLElement | SVGElement>('[data-branch]')];
			let progress = 1;
			let frame = 0;
			let before = 0;

			const render = () => {
				const acting = growing(progress);

				show(progress);
				range.value = String(Math.round(progress * 1000));
				for (const branch of branches) {
					branch.classList.toggle('acting', Number(branch.dataset.branch) === acting);
				}
			};

			const stop = () => {
				cancelAnimationFrame(frame);
				frame = 0;
				delete toggle.dataset.on;
			};

			const step = (now: number) => {
				progress = Math.min(1, progress + (now - before) / length);
				before = now;
				render();

				if (progress < 1) {
					frame = requestAnimationFrame(step);
				} else {
					stop();
				}
			};

			const play = () => {
				if (progress === 1) {
					progress = 0;
				}

				before = performance.now();
				toggle.dataset.on = '';
				frame = requestAnimationFrame(step);
			};

			toggle.addEventListener('click', () => (frame ? stop() : play()));
			range.addEventListener('input', () => {
				stop();
				progress = Number(range.value) / 1000;
				render();
			});

			this.querySelector<HTMLElement>('.growth-controls')!.hidden = false;

			if (reducedMotion.matches) {
				render();
				return;
			}

			// Nothing is drawn until the figure is seen, so the growth is not
			// spent above or below the screen.
			progress = 0;
			render();
			whenSeen(this, () => {
				if (progress === 0) {
					play();
				}
			});
		}
	}

	customElements.define('ink-growth', InkGrowth);
</script>

<style>
	ink-growth {
		display: block;
		min-width: 0;
	}

	.inner {
		fill: none;
		stroke: var(--ink);
		stroke-width: 0.8;
	}

	/* What grows: a line is drawn, a box is set down, a label settles. With
	   no script, --t is never set, and everything is simply there. */
	.draw {
		stroke-dasharray: 1;
		stroke-dashoffset: calc(1 - var(--t, 1));
	}

	.press {
		opacity: var(--t, 1);
		transform: scale(calc(0.96 + 0.04 * var(--t, 1)));
		transform-box: fill-box;
		transform-origin: center;
	}

	.settle {
		opacity: var(--t, 1);
		transform: translateY(calc((1 - var(--t, 1)) * 6px));
	}

	.leaf text {
		fill: var(--ink);
	}

	.leaf:hover text {
		fill: var(--red);
		text-decoration: underline;
	}

	/* The branch that is growing is the one that acts. */
	.acting .wire,
	.acting .box {
		stroke: var(--red);
	}

	.acting .name {
		fill: var(--red);
	}

	.growth-list {
		display: none;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.growth-list > li + li {
		position: relative;
		margin-top: 0.5lh;
		padding-left: 3ch;
		border-left: 1px solid var(--ink);
	}

	.growth-list > li + li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.85em;
		width: 2ch;
		border-top: 1px solid var(--ink);
	}

	.growth-list a {
		text-decoration-color: var(--red);
	}

	.growth-list a span,
	.growth-list > li > span {
		color: var(--dim);
	}

	.growth-list .caption {
		display: block;
	}

	.growth-list ul {
		margin: 0.2lh 0 0;
		padding: 0 0 0 2ch;
		list-style: none;
	}

	.growth-list .acting > a,
	.growth-list .acting > a b {
		color: var(--red);
	}

	.growth-controls {
		display: flex;
		align-items: center;
		gap: 2ch;
		margin-top: 0.75lh;
	}

	.growth-controls input {
		flex: 1;
		max-width: 40ch;
		height: 1lh;
		margin: 0;
		background: none;
		appearance: none;
		cursor: pointer;
	}

	.growth-controls input::-webkit-slider-runnable-track {
		height: 1px;
		background: var(--ink);
	}

	.growth-controls input::-moz-range-track {
		height: 1px;
		background: var(--ink);
	}

	.growth-controls input::-webkit-slider-thumb {
		width: 0.8em;
		height: 0.8em;
		margin-top: calc(-0.4em + 0.5px);
		border: 0;
		border-radius: 0;
		background: var(--ink);
		appearance: none;
	}

	.growth-controls input::-moz-range-thumb {
		width: 0.8em;
		height: 0.8em;
		border: 0;
		border-radius: 0;
		background: var(--ink);
	}

	/* Too narrow for the drawing to be read: the same tree, as a list. */
	@container (max-width: 40rem) {
		.wide {
			display: none;
		}

		.growth-list {
			display: block;
		}
	}
</style>
