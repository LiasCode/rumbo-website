---
import { href, type Locale } from '../navigation';
import Icon from './Icon.astro';

// One run of rumbo 0.13.0, frame by frame, in the two ways a front end and
// a host come to speak: the host starts the front end ("attached"), or the
// front end starts the host. The frames are those a host was seen to send
// and take with a provider and an extension made for the purpose; nothing
// here calls a model.
const { locale, number = 1 } = Astro.props as { locale: Locale; number?: number };

const copy = {
	en: {
		title: 'Follow one run',
		summary: 'A front end, the host, a provider, and an extension, speaking JSON-RPC line by line. The task is made up; the frames are the ones rumbo 0.13.0 sends.',
		reference: 'Front end protocol',
		mode: 'Who starts whom',
		modes: ['Attached · rumbo starts the front end', 'Standalone · the front end starts rumbo'],
		speed: 'Speed',
		previous: 'Previous',
		next: 'Next',
		play: 'Play',
		pause: 'Pause',
		frames: 'Frames',
		conversation: 'What the person sees',
		parts: ['Front end', 'Host', 'Provider', 'Extension'],
		starts: 'starts',
		person: 'You',
		model: 'Model',
		question: 'How much black ink is in stock?',
		stock: 'Black ink: 3 bottles',
		answer: 'There are three bottles of black ink.',
		start: [
			'You run rumbo. It starts the registered front end and speaks with it on the front end’s descriptors 3 and 4, so the terminal stays the front end’s.',
			'Your program starts the host and speaks with it on the host’s stdin and stdout, as an editor would.',
		],
		details: [
			'The host always speaks first: where it works, with which provider and model, and what it can be asked.',
			'The front end answers with the protocol version it speaks and its name.',
			'Nothing runs until the front end asks. It sends the task, and keeps the request’s id.',
			'The run needs a model and tools, so the host starts the provider and the extension and learns what each offers.',
			'The host says what context the model is given, and sends the provider the whole conversation and the tools.',
			'The model wants a tool. The host records the answer and reports the turn and its tokens.',
			'The tool is the extension’s, so the host passes it the call, and tells the front end it began.',
			'The extension answers. The result goes into the session, and to the front end.',
			'The host asks again. The request is the one before plus the tool’s result, so the provider’s cache still holds its start.',
			'The provider streams text as it comes, and the host passes each piece on.',
			'The model calls no more tools, which is how it says it is done.',
			'The host records how the run ended and answers the request that started it.',
		],
	},
	es: {
		title: 'Sigue una ejecución',
		summary: 'Una interfaz, el host, un proveedor y una extensión hablando JSON-RPC línea a línea. La tarea es inventada; los mensajes son los que envía rumbo 0.13.0.',
		reference: 'Protocolo de interfaz',
		mode: 'Quién arranca a quién',
		modes: ['Attached · rumbo abre la interfaz', 'Independiente · la interfaz abre rumbo'],
		speed: 'Velocidad',
		previous: 'Anterior',
		next: 'Siguiente',
		play: 'Reproducir',
		pause: 'Pausar',
		frames: 'Mensajes',
		conversation: 'Lo que ve la persona',
		parts: ['Interfaz', 'Host', 'Proveedor', 'Extensión'],
		starts: 'arranca',
		person: 'Tú',
		model: 'Modelo',
		question: '¿Cuánta tinta negra queda?',
		stock: 'Tinta negra: 3 botellas',
		answer: 'Quedan tres botellas de tinta negra.',
		start: [
			'Ejecutas rumbo. Arranca la interfaz registrada y habla con ella por los descriptores 3 y 4 de la interfaz, así que la terminal sigue siendo suya.',
			'Tu programa arranca el host y habla con él por el stdin y el stdout del host, como haría un editor.',
		],
		details: [
			'El host siempre habla primero: dónde trabaja, con qué proveedor y modelo, y qué se le puede pedir.',
			'La interfaz responde con la versión del protocolo que habla y su nombre.',
			'Nada se ejecuta hasta que la interfaz lo pide. Envía la tarea y guarda el id de la petición.',
			'La ejecución necesita un modelo y herramientas, así que el host arranca el proveedor y la extensión y averigua qué ofrece cada uno.',
			'El host dice qué contexto recibe el modelo y envía al proveedor toda la conversación y las herramientas.',
			'El modelo quiere una herramienta. El host registra la respuesta e informa del turno y sus tokens.',
			'La herramienta es de la extensión, así que el host le pasa la llamada y avisa a la interfaz de que empezó.',
			'La extensión responde. El resultado va a la sesión y a la interfaz.',
			'El host vuelve a preguntar. La petición es la anterior más el resultado, así que la caché del proveedor conserva su comienzo.',
			'El proveedor transmite el texto según llega, y el host reenvía cada fragmento.',
			'El modelo no pide más herramientas: así dice que ha terminado.',
			'El host registra cómo terminó la ejecución y responde a la petición que la inició.',
		],
	},
	fr: {
		title: 'Suivre une exécution',
		summary: 'Une interface, l’hôte, un fournisseur et une extension qui se parlent en JSON-RPC, ligne par ligne. La tâche est inventée ; les messages sont ceux qu’envoie rumbo 0.13.0.',
		reference: 'Protocole d’interface',
		mode: 'Qui lance qui',
		modes: ['Attaché · rumbo lance l’interface', 'Indépendant · l’interface lance rumbo'],
		speed: 'Vitesse',
		previous: 'Précédent',
		next: 'Suivant',
		play: 'Lire',
		pause: 'Pause',
		frames: 'Messages',
		conversation: 'Ce que voit la personne',
		parts: ['Interface', 'Hôte', 'Fournisseur', 'Extension'],
		starts: 'lance',
		person: 'Vous',
		model: 'Modèle',
		question: 'Combien reste-t-il d’encre noire ?',
		stock: 'Encre noire : 3 bouteilles',
		answer: 'Il reste trois bouteilles d’encre noire.',
		start: [
			'Vous lancez rumbo. Il lance l’interface enregistrée et lui parle sur les descripteurs 3 et 4 de l’interface : le terminal reste à elle.',
			'Votre programme lance l’hôte et lui parle sur le stdin et le stdout de l’hôte, comme le ferait un éditeur.',
		],
		details: [
			'L’hôte parle toujours en premier : où il travaille, avec quel fournisseur et quel modèle, et ce qu’on peut lui demander.',
			'L’interface répond avec la version du protocole qu’elle parle et son nom.',
			'Rien ne s’exécute tant que l’interface ne le demande pas. Elle envoie la tâche et garde l’id de la requête.',
			'L’exécution a besoin d’un modèle et d’outils : l’hôte lance le fournisseur et l’extension et apprend ce que chacun offre.',
			'L’hôte dit quel contexte reçoit le modèle et envoie au fournisseur toute la conversation et les outils.',
			'Le modèle veut un outil. L’hôte consigne la réponse et signale le tour et ses tokens.',
			'L’outil est celui de l’extension : l’hôte lui passe l’appel et prévient l’interface qu’il a commencé.',
			'L’extension répond. Le résultat va dans la session et à l’interface.',
			'L’hôte redemande. La requête est la précédente plus le résultat : le cache du fournisseur en garde le début.',
			'Le fournisseur transmet le texte au fil de l’eau, et l’hôte relaie chaque morceau.',
			'Le modèle n’appelle plus d’outil : c’est sa façon de dire qu’il a fini.',
			'L’hôte consigne la fin de l’exécution et répond à la requête qui l’a lancée.',
		],
	},
	it: {
		title: 'Segui un’esecuzione',
		summary: 'Un’interfaccia, l’host, un provider e un’estensione che parlano JSON-RPC riga per riga. Il compito è inventato; i messaggi sono quelli che invia rumbo 0.13.0.',
		reference: 'Protocollo dell’interfaccia',
		mode: 'Chi avvia chi',
		modes: ['Collegata · rumbo avvia l’interfaccia', 'Indipendente · l’interfaccia avvia rumbo'],
		speed: 'Velocità',
		previous: 'Indietro',
		next: 'Avanti',
		play: 'Riproduci',
		pause: 'Pausa',
		frames: 'Messaggi',
		conversation: 'Ciò che vede la persona',
		parts: ['Interfaccia', 'Host', 'Provider', 'Estensione'],
		starts: 'avvia',
		person: 'Tu',
		model: 'Modello',
		question: 'Quanto inchiostro nero rimane?',
		stock: 'Inchiostro nero: 3 bottiglie',
		answer: 'Rimangono tre bottiglie di inchiostro nero.',
		start: [
			'Esegui rumbo. Avvia l’interfaccia registrata e le parla sui descrittori 3 e 4 dell’interfaccia, così il terminale resta suo.',
			'Il tuo programma avvia l’host e gli parla sullo stdin e sullo stdout dell’host, come farebbe un editor.',
		],
		details: [
			'L’host parla sempre per primo: dove lavora, con quale provider e modello, e cosa gli si può chiedere.',
			'L’interfaccia risponde con la versione del protocollo che parla e il suo nome.',
			'Nulla parte finché l’interfaccia non lo chiede. Invia il compito e conserva l’id della richiesta.',
			'L’esecuzione ha bisogno di un modello e di strumenti: l’host avvia il provider e l’estensione e scopre cosa offre ciascuno.',
			'L’host dice quale contesto riceve il modello e invia al provider tutta la conversazione e gli strumenti.',
			'Il modello vuole uno strumento. L’host registra la risposta e segnala il turno e i suoi token.',
			'Lo strumento è dell’estensione: l’host le passa la chiamata e avvisa l’interfaccia che è iniziata.',
			'L’estensione risponde. Il risultato va nella sessione e all’interfaccia.',
			'L’host chiede di nuovo. La richiesta è la precedente più il risultato, così la cache del provider ne conserva l’inizio.',
			'Il provider trasmette il testo man mano che arriva, e l’host inoltra ogni pezzo.',
			'Il modello non chiama altri strumenti: è così che dice di aver finito.',
			'L’host registra com’è finita l’esecuzione e risponde alla richiesta che l’ha avviata.',
		],
	},
}[locale];

const modes = [
	{ id: 'attached', label: copy.modes[0], command: 'rumbo -f ink-ui', pipes: ['fd 3', 'fd 4'], detail: copy.start[0] },
	{ id: 'standalone', label: copy.modes[1], command: 'rumbo serve', pipes: ['stdout', 'stdin'], detail: copy.start[1] },
] as const;

// Each step after the start: the frames that cross, as "from>to:label",
// and the line of JSON-RPC that matters in it.
const frames = [
	{ hops: ['host>fe:initialize'], code: 'initialize { protocol: 3, dir, provider, model, functions }' },
	{ hops: ['fe>host:result'], code: 'result { protocol: 3, name: "ink-ui" }' },
	{ hops: ['fe>host:run'], code: 'run #20 { objective: "…" }' },
	{ hops: ['host>provider:initialize', 'host>extension:initialize'], code: 'initialize → { tools: [ink_catalog] }' },
	{ hops: ['host>fe:event context', 'host>provider:complete'], code: 'complete { model, system, messages, tools }' },
	{ hops: ['provider>host:result', 'host>fe:event turn'], code: 'result { stop: "tool_calls", usage }' },
	{ hops: ['host>fe:event tool_started', 'host>extension:call'], code: 'call { name: "ink_catalog", args: { color: "black" } }' },
	{ hops: ['extension>host:result', 'host>fe:event tool_finished'], code: 'result { text: "Black ink: 3 bottles" }' },
	{ hops: ['host>provider:complete'], code: 'complete { messages: […, tool_result] }' },
	{ hops: ['provider>host:delta', 'host>fe:event text'], code: 'delta { text } → event { type: "text" }' },
	{ hops: ['provider>host:result', 'host>fe:event turn'], code: 'result { stop: "end", usage }' },
	{ hops: ['host>fe:result'], code: 'result #20 { status: "done", session }' },
].map((frame, index) => ({ ...frame, detail: copy.details[index] }));

const names: Record<string, string> = { fe: copy.parts[0], host: copy.parts[1], provider: copy.parts[2], extension: copy.parts[3] };
const kinds: Record<string, string> = { fe: 'ink-ui', host: 'rumbo 0.13.0', provider: 'stdin · stdout', extension: 'stdin · stdout' };
const route = (hops: string[]) => hops.map((hop) => hop.split(':')[0].split('>').map((part) => names[part]).join(' → ')).join(' · ');
const segment = ([x1, y1, x2, y2]: readonly number[]) => `M${x1} ${y1}L${x2} ${y2}`;

// The stage is drawn twice, wide and tall, and a narrow figure gets the
// tall one. Each says where its parts stand and the line every frame flies.
const stages = [
	{
		shape: 'wide',
		width: 800,
		height: 400,
		box: [176, 66],
		nodes: { fe: [110, 206], host: [400, 206], provider: [690, 92], extension: [690, 320] },
		links: { 'host>fe': [312, 193, 198, 193], 'fe>host': [198, 219, 312, 219], 'host>provider': [488, 190, 602, 104], 'provider>host': [602, 104, 488, 190], 'host>extension': [488, 222, 602, 308], 'extension>host': [602, 308, 488, 222] },
		arcs: { attached: 'M372 173C340 92 170 92 138 166', standalone: 'M138 173C170 92 340 92 372 166' },
		command: [255, 96, 0],
		pipes: [
			[255, 184, 'middle'],
			[255, 239, 'middle'],
		],
	},
	{
		shape: 'tall',
		width: 340,
		height: 470,
		box: [150, 56],
		nodes: { fe: [186, 44], host: [186, 226], provider: [84, 420], extension: [256, 420] },
		links: { 'host>fe': [172, 198, 172, 72], 'fe>host': [200, 72, 200, 198], 'host>provider': [150, 254, 100, 392], 'provider>host': [100, 392, 150, 254], 'host>extension': [222, 254, 256, 392], 'extension>host': [256, 392, 222, 254] },
		arcs: { attached: 'M111 214C34 190 34 80 106 54', standalone: 'M111 56C34 80 34 190 106 216' },
		command: [30, 135, -90],
		pipes: [
			[164, 139, 'end'],
			[208, 139, 'start'],
		],
	},
] as const;
---

<h3 class="body" id="run-trace">{copy.title}</h3>

<run-trace data-mode="attached">
	<figure class="figure" aria-label={copy.title}>
		<div class="trace-controls" hidden>
			<fieldset class="choice">
				<legend>{copy.mode}</legend>
				{modes.map(({ id, label }, index) => <label><input type="radio" name="trace-mode" value={id} checked={index === 0} data-mode-choice /><span class="control">{label}</span></label>)}
			</fieldset>
			<fieldset class="choice">
				<legend>{copy.speed}</legend>
				{['0.5', '1', '2'].map((speed) => <label><input type="radio" name="trace-speed" value={speed} checked={speed === '1'} data-speed-choice /><span class="control">{speed}×</span></label>)}
			</fieldset>
			<div class="trace-actions">
				<span class="trace-count" data-count></span>
				<button type="button" class="control" data-prev aria-label={copy.previous} title={copy.previous}><Icon name="arrow-left" /></button>
				<button type="button" class="control" data-playback><span class="when-off">{copy.play}</span><span class="when-on">{copy.pause}</span></button>
				<button type="button" class="control" data-next aria-label={copy.next} title={copy.next}><Icon name="arrow-right" /></button>
			</div>
		</div>

		{stages.map(({ shape, width, height, box, nodes, links, arcs, command, pipes }) => (
			<svg class:list={['drawing', 'stage', shape]} viewBox={`0 0 ${width} ${height}`} data-links={JSON.stringify(links)} aria-hidden="true">
				<defs>
					<marker id={`tip-${shape}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
						<path class="tip" d="M0 0L10 5L0 10z" />
					</marker>
				</defs>

				<path class="wire" d={segment(links['host>fe'])} marker-end={`url(#tip-${shape})`} />
				<path class="wire" d={segment(links['fe>host'])} marker-end={`url(#tip-${shape})`} />
				{(['provider', 'extension'] as const).map((part) => <path class="wire" d={segment(links[`host>${part}`])} />)}

				{modes.map(({ id, command: text, pipes: labels }) => (
					<g class="topology" data-topology={id}>
						<path class="wire spawn" d={arcs[id]} pathLength="1" marker-end={`url(#tip-${shape})`} />
						<text x={command[0]} y={command[1]} text-anchor="middle" transform={command[2] ? `rotate(${command[2]} ${command[0]} ${command[1]})` : undefined}>
							{copy.starts} · <tspan class="command">{text}</tspan>
						</text>
						{labels.map((label, index) => <text x={pipes[index][0]} y={pipes[index][1]} text-anchor={pipes[index][2]}>{label}</text>)}
					</g>
				))}

				<path class="trail" pathLength="1" />

				{Object.entries(nodes).map(([part, [x, y]]) => (
					<g class="node" data-part={part}>
						<rect class="box" x={x - box[0] / 2} y={y - box[1] / 2} width={box[0]} height={box[1]} />
						<text class="name" {x} y={y - 2} text-anchor="middle">{names[part]}</text>
						<text {x} y={y + 17} text-anchor="middle">{kinds[part]}</text>
					</g>
				))}

				<g class="packet">
					<rect class="box" height="24" y="-12" />
					<text class="packet-label" y="4.5" text-anchor="middle"></text>
				</g>
			</svg>
		))}

		<p class="trace-now" data-now aria-live="polite"></p>

		<div class="trace-body">
			<aside class="trace-chat">
				<h4>{copy.conversation}</h4>
				<p data-at="3"><b>{copy.person}</b> <span>{copy.question}</span></p>
				<p class="tool" data-at="8"><b>ink_catalog</b> <span>{copy.stock}</span></p>
				<p data-at="10"><b>{copy.model}</b> <span data-typed>{copy.answer}</span></p>
			</aside>

			<div class="trace-log">
				<h4>{copy.frames}</h4>
				<ol>
					{modes.map(({ id, label, command, detail }) => (
						<li data-step="0" data-topology={id} data-hops="">
							<button type="button">
								<span class="row-index">00</span>
								<span class="row-route">{label}</span>
								<code>{command}</code>
								<span class="row-detail">{detail}</span>
							</button>
						</li>
					))}
					{frames.map(({ hops, code, detail }, index) => (
						<li data-step={index + 1} data-hops={hops.join('|')}>
							<button type="button">
								<span class="row-index">{String(index + 1).padStart(2, '0')}</span>
								<span class="row-route">{route(hops)}</span>
								<code>{code}</code>
								<span class="row-detail">{detail}</span>
							</button>
						</li>
					))}
				</ol>
			</div>
		</div>

		<figcaption><b>Fig. {number} ·</b> {copy.summary} <a href={href(locale, 'reference/frontend-protocol')}>{copy.reference}</a></figcaption>
	</figure>
</run-trace>

<script>
	import { reducedMotion, whenSeen } from './timeline';

	// The step before which the provider and the extension are not running,
	// and the step whose answer is typed as it streams.
	const started = 4;
	const streamed = 10;

	const pause = (time: number) => new Promise((resolve) => setTimeout(resolve, time));

	class RunTrace extends HTMLElement {
		connectedCallback() {
			const modes = [...this.querySelectorAll<HTMLInputElement>('[data-mode-choice]')];
			const speeds = [...this.querySelectorAll<HTMLInputElement>('[data-speed-choice]')];
			const playback = this.querySelector<HTMLButtonElement>('[data-playback]')!;
			const previous = this.querySelector<HTMLButtonElement>('[data-prev]')!;
			const next = this.querySelector<HTMLButtonElement>('[data-next]')!;
			const count = this.querySelector<HTMLElement>('[data-count]')!;
			const now = this.querySelector<HTMLElement>('[data-now]')!;
			const log = this.querySelector<HTMLElement>('.trace-log ol')!;
			const rows = [...this.querySelectorAll<HTMLElement>('[data-step]')];
			const bubbles = [...this.querySelectorAll<HTMLElement>('[data-at]')];
			const typed = this.querySelector<HTMLElement>('[data-typed]')!;
			const answer = typed.textContent!;
			const last = Math.max(...rows.map((row) => Number(row.dataset.step)));
			let step = 0;
			// Every start and stop takes a new turn, so whatever was moving
			// for the turn before knows it is over.
			let turn = 0;
			let playing = false;

			const mode = () => modes.find((each) => each.checked)!.value;
			const speed = () => Number(speeds.find((each) => each.checked)!.value);
			const stage = () => [...this.querySelectorAll<SVGSVGElement>('.stage')].find((each) => getComputedStyle(each).display !== 'none')!;
			const row = () => rows.find((each) => Number(each.dataset.step) === step && (!each.dataset.topology || each.dataset.topology === mode()))!;

			const render = () => {
				this.dataset.mode = mode();
				this.classList.toggle('cold', step < started);

				for (const each of rows) {
					const at = Number(each.dataset.step);

					each.hidden = Boolean(each.dataset.topology) && each.dataset.topology !== mode();
					each.classList.toggle('now', at === step);
					each.classList.toggle('done', at < step);
				}

				for (const bubble of bubbles) {
					bubble.hidden = step < Number(bubble.dataset.at);
				}

				const current = row();

				typed.textContent = answer;
				now.replaceChildren(...[...current.querySelectorAll('code, .row-detail')].map((part) => part.cloneNode(true)));
				count.textContent = `${String(step).padStart(2, '0')} / ${String(last).padStart(2, '0')}`;
				previous.disabled = step === 0;
				next.disabled = step === last;
				// Only the list moves, never the page.
				log.scrollTo({ top: current.offsetTop - log.clientHeight / 3, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
			};

			// One frame crossing the stage: a labelled packet along its line,
			// leaving a trail that fades behind it. The sender is the part
			// that acts, so it is the one in red while the frame flies.
			const fly = async (hop: string, mine: number) => {
				const [path, label] = hop.split(':');
				const [from, to] = path.split('>');
				const scene = stage();
				const [x1, y1, x2, y2] = JSON.parse(scene.dataset.links!)[path] as number[];
				const packet = scene.querySelector<SVGGElement>('.packet')!;
				const trail = scene.querySelector<SVGPathElement>('.trail')!;
				const plate = packet.querySelector('rect')!;
				const sender = scene.querySelector(`.node[data-part="${from}"]`)!;
				const wide = label.length * 7.6 + 20;
				const time = 780 / speed();
				const along = (share: number) => `translate(${x1 + (x2 - x1) * share}px, ${y1 + (y2 - y1) * share}px)`;

				packet.querySelector('text')!.textContent = label;
				plate.setAttribute('width', String(wide));
				plate.setAttribute('x', String(-wide / 2));
				trail.setAttribute('d', `M${x1} ${y1}L${x2} ${y2}`);
				sender.classList.add('speaking');

				trail.animate(
					[
						{ strokeDashoffset: 1, opacity: 1 },
						{ strokeDashoffset: 0, opacity: 1, offset: 0.7 },
						{ strokeDashoffset: 0, opacity: 0 },
					],
					{ duration: time * 1.5 },
				);

				await packet
					.animate(
						[
							{ transform: `${along(0)} scale(0.6)`, opacity: 0 },
							{ transform: `${along(0.12)} scale(1)`, opacity: 1, offset: 0.12 },
							{ transform: `${along(0.9)} scale(1)`, opacity: 1, offset: 0.88 },
							{ transform: `${along(1)} scale(0.6)`, opacity: 0 },
						],
						{ duration: time, easing: 'cubic-bezier(0.45, 0, 0.25, 1)' },
					)
					.finished.catch(() => {});

				sender.classList.remove('speaking');

				if (mine === turn) {
					const receiver = scene.querySelector(`.node[data-part="${to}"]`)!;

					receiver.classList.remove('struck');
					receiver.getBoundingClientRect();
					receiver.classList.add('struck');
				}
			};

			// What a step shows while it happens: its frames, one after the
			// other, and for the streamed answer, its letters.
			const act = async (mine: number) => {
				if (reducedMotion.matches) {
					return;
				}

				const current = row();

				// The answer is not there until it streams.
				if (step === streamed) {
					typed.textContent = '';
				}

				if (step === 0) {
					const spawn = stage().querySelector<SVGPathElement>(`[data-topology="${mode()}"] .spawn`)!;

					await spawn.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 900 / speed(), easing: 'ease-out' }).finished.catch(() => {});
				}

				for (const hop of current.dataset.hops!.split('|').filter(Boolean)) {
					if (mine !== turn) {
						return;
					}

					if (step === streamed && hop.endsWith('text')) {
						void fly(hop, mine);

						for (let shown = 0; shown <= answer.length && mine === turn; shown += 2) {
							typed.textContent = answer.slice(0, shown);
							await pause(26 / speed());
						}

						if (mine === turn) {
							typed.textContent = answer;
						}
					} else {
						await fly(hop, mine);
					}
				}
			};

			const stop = () => {
				turn += 1;
				playing = false;
				delete playback.dataset.on;

				// Only what this script set moving: the styles' own go on.
				for (const animation of this.getAnimations({ subtree: true })) {
					if (animation.constructor === Animation) {
						animation.cancel();
					}
				}
			};

			const go = (target: number) => {
				stop();
				step = Math.min(last, Math.max(0, target));
				render();
				void act(turn);
			};

			// Playing goes through one way of starting, rests on its last
			// frame, and then goes through the other.
			const play = async () => {
				stop();
				playing = true;
				playback.dataset.on = '';

				const mine = turn;

				if (step === last) {
					step = 0;
					render();
				}

				while (mine === turn) {
					await act(mine);
					await pause((step === last ? 2600 : 850) / speed());

					if (mine !== turn) {
						return;
					}

					if (step === last) {
						modes[(modes.findIndex((each) => each.checked) + 1) % modes.length].checked = true;
						step = 0;
					} else {
						step += 1;
					}

					render();
				}
			};

			playback.addEventListener('click', () => (playing ? stop() : void play()));
			previous.addEventListener('click', () => go(step - 1));
			next.addEventListener('click', () => go(step + 1));
			for (const each of modes) {
				each.addEventListener('change', () => go(0));
			}

			for (const each of rows) {
				each.querySelector('button')!.addEventListener('click', () => go(Number(each.dataset.step)));
			}

			this.classList.add('interactive');
			this.querySelector<HTMLElement>('.trace-controls')!.hidden = false;
			render();

			if (!reducedMotion.matches) {
				whenSeen(this, () => void play(), 0.3);
			}
		}
	}

	customElements.define('run-trace', RunTrace);
</script>

