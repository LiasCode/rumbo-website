---
import { brush, type Point } from './ink';

// A rule between two parts of a page, as one pull of a brush that is
// running dry. It draws itself across when it is first seen.
const { seed = 1 } = Astro.props as { seed?: number };
const points: Point[] = Array.from({ length: 60 }, (_, index) => [index * 20 + 6, 9 + Math.sin(index / 9 + seed) * 1.6]);
const width = (t: number) => 9 * (1 - t) ** 0.45 + 0.8;
---

<svg class="rule" data-seen viewBox="0 0 1200 18" preserveAspectRatio="none" aria-hidden="true">
	<path d={brush(points, width, seed * 13, 0.42)} />
</svg>

<style>
	.rule {
		display: block;
		width: 100%;
		height: 0.8rem;
		margin-bottom: 1.4rem;
		fill: var(--ink);
		clip-path: inset(0 0 0 0);
	}

	:global(.moving) .rule {
		clip-path: inset(0 100% 0 0);
		transition: clip-path 1.1s cubic-bezier(0.6, 0, 0.2, 1);
	}

	:global(.moving) .rule:global(.seen) {
		clip-path: inset(0 0 0 0);
	}
</style>
