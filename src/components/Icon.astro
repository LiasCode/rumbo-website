---
// The site's icons: one grid, one stroke, the color of the text around
// them. Every arrow, mark, and control on the site is drawn from here, so
// none is a character of whatever font the reader happens to have.
const paths = {
	'arrow-right': 'M4 12h15M13 6l6 6-6 6',
	'arrow-left': 'M20 12H5M11 6l-6 6 6 6',
	'arrow-down': 'M12 4v15M6 13l6 6 6-6',
	'arrow-up-right': 'M7 17 17 7M8.5 7H17v8.5',
	'chevron-down': 'M6 9.5l6 6 6-6',
	search: 'M10.5 4.5a6 6 0 1 0 0 12 6 6 0 0 0 0-12ZM15 15l4.5 4.5',
	close: 'M6 6l12 12M18 6 6 18',
	copy: 'M9 9h10v11H9zM15 9V4H5v11h4',
	check: 'M5 12.5l4.5 4.5L19 7.5',
	play: 'M8 5.5v13l10.5-6.5z',
	pause: 'M8 5.5v13M16 5.5v13',
};

interface Props {
	name: keyof typeof paths;
	class?: string;
}

const { name, class: extra } = Astro.props;
---

<svg class:list={['icon', extra]} viewBox="0 0 24 24" aria-hidden="true"><path d={paths[name]}></path></svg>
