---
// The site's icons: one grid, one stroke, the color of the text around
// them. Every arrow on the site is drawn from here, so none is a character
// of whatever font the reader happens to have.
const paths = {
	'arrow-right': 'M4 12h15M13 6l6 6-6 6',
	'arrow-left': 'M20 12H5M11 6l-6 6 6 6',
	'arrow-both': 'M4 12h16M9 7l-5 5 5 5M15 7l5 5-5 5',
};

interface Props {
	name: keyof typeof paths;
	class?: string;
}

const { name, class: extra } = Astro.props;
---

<svg class:list={['icon', extra]} viewBox="0 0 24 24" aria-hidden="true"><path d={paths[name]}></path></svg>
