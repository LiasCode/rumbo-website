---
import Site from '../layouts/Site.astro';
import Growth from './Growth.astro';
import Icon from './Icon.astro';
import RunTrace from './RunTrace.astro';
import Compositions from './Compositions.astro';
import { href, interfaceCopy, type Locale } from '../navigation';
import { repository, release } from '../site.mjs';

// The front page is the manual page of rumbo itself: its name, how it is
// run, what it is, a run and what the parts make, what to build, and what
// to read next.
const { locale } = Astro.props as { locale: Locale };
const ui = interfaceCopy[locale];
// The head of the section about what people build.
const yours = { en: 'Your own parts', es: 'Piezas propias', fr: 'Vos propres pièces', it: 'Pezzi tuoi' }[locale];
const copy = {
	en: { title: 'A minimal agent harness', first: 'A small core.', second: 'An open system.', description: 'One host orchestrates the work. Choose the interface, connect a model and add the tools you need.', start: 'Get started', install: 'Install and run', installText: 'Linux or macOS. From a release or with Go.', learn: 'Work with rumbo', learnText: 'Sessions, models, settings and scripting.', build: 'Make it yours', buildText: 'Build a provider, interface or extension in any language.', task: 'Summarize this directory without changing files' },
	es: { title: 'Un motor de agentes minimalista', first: 'Un núcleo pequeño.', second: 'Un sistema abierto.', description: 'Un núcleo coordina el trabajo. Elige la interfaz, conecta un modelo y añade las herramientas que necesites.', start: 'Empezar', install: 'Instalar y ejecutar', installText: 'Linux o macOS. Desde una versión publicada o con Go.', learn: 'Trabajar con rumbo', learnText: 'Sesiones, modelos, configuración y scripts.', build: 'Hazlo tuyo', buildText: 'Crea un proveedor, una interfaz o una extensión en cualquier lenguaje.', task: 'Summarize this directory without changing files' },
	fr: { title: 'Un moteur d’agents minimaliste', first: 'Un petit noyau.', second: 'Un système ouvert.', description: 'Un noyau orchestre le travail. Choisissez une interface, connectez un modèle et ajoutez les outils nécessaires.', start: 'Commencer', install: 'Installer et lancer', installText: 'Linux ou macOS. Depuis une version publiée ou avec Go.', learn: 'Travailler avec rumbo', learnText: 'Sessions, modèles, configuration et scripts.', build: 'À votre façon', buildText: 'Créez un fournisseur, une interface ou une extension dans le langage de votre choix.', task: 'Summarize this directory without changing files' },
	it: { title: 'Un motore per agenti minimalista', first: 'Un nucleo piccolo.', second: 'Un sistema aperto.', description: 'Un nucleo coordina il lavoro. Scegli l’interfaccia, collega un modello e aggiungi gli strumenti che ti servono.', start: 'Inizia', install: 'Installa ed esegui', installText: 'Linux o macOS. Da una versione pubblicata o con Go.', learn: 'Lavora con rumbo', learnText: 'Sessioni, modelli, configurazione e script.', build: 'Fallo tuo', buildText: 'Crea un provider, un’interfaccia o un’estensione in qualsiasi linguaggio.', task: 'Summarize this directory without changing files' },
}[locale];

const own = {
	"en": [
		"Make it yours, and share it",
		"rumbo comes with a complete terminal UI and three providers, so it works the day you install it. rumbo-claude and rumbo-gui are there to add if you want them. But the point of rumbo is what you build: write the parts you are missing, in any language, and put them in a Git repository so others can add them with one command.",
		[
			[
				"A front end",
				"For the way you work: your editor, a chat, a web page."
			],
			[
				"A provider",
				"For the model you use, wherever it runs."
			],
			[
				"An extension",
				"For the tools and the context your work needs."
			],
			[
				"A plugin",
				"All of it in one repository, for anyone to add."
			]
		]
	],
	"es": [
		"Hazlo tuyo y compártelo",
		"rumbo trae una interfaz de terminal completa y tres proveedores, así que funciona el día que lo instalas. rumbo-claude y rumbo-gui están ahí para añadirlos si los quieres. Pero lo importante de rumbo es lo que construyes tú: escribe las piezas que te faltan, en cualquier lenguaje, y ponlas en un repositorio Git para que otros las añadan con un comando.",
		[
			[
				"Una interfaz",
				"Para tu forma de trabajar: tu editor, un chat, una web."
			],
			[
				"Un proveedor",
				"Para el modelo que usas, esté donde esté."
			],
			[
				"Una extensión",
				"Para las herramientas y el contexto que necesita tu trabajo."
			],
			[
				"Un plugin",
				"Todo en un repositorio, para que cualquiera lo añada."
			]
		]
	],
	"fr": [
		"Faites-le vôtre, et partagez-le",
		"rumbo apporte une interface en terminal complète et trois fournisseurs : il fonctionne le jour où vous l’installez. rumbo-claude et rumbo-gui sont là si vous voulez les ajouter. Mais l’essentiel de rumbo est ce que vous construisez : écrivez les pièces qui vous manquent, dans n’importe quel langage, et mettez-les dans un dépôt Git pour que d’autres les ajoutent en une commande.",
		[
			[
				"Une interface",
				"Pour votre façon de travailler : votre éditeur, un chat, une page web."
			],
			[
				"Un fournisseur",
				"Pour le modèle que vous utilisez, où qu’il tourne."
			],
			[
				"Une extension",
				"Pour les outils et le contexte dont votre travail a besoin."
			],
			[
				"Un plugin",
				"Le tout dans un dépôt, que chacun peut ajouter."
			]
		]
	],
	"it": [
		"Fallo tuo, e condividilo",
		"rumbo porta un’interfaccia da terminale completa e tre provider: funziona il giorno in cui lo installi. rumbo-claude e rumbo-gui sono lì se vuoi aggiungerli. Ma il punto di rumbo è ciò che costruisci tu: scrivi i pezzi che ti mancano, in qualsiasi linguaggio, e mettili in un repository Git perché altri li aggiungano con un comando.",
		[
			[
				"Un’interfaccia",
				"Per il tuo modo di lavorare: il tuo editor, una chat, una pagina web."
			],
			[
				"Un provider",
				"Per il modello che usi, ovunque giri."
			],
			[
				"Un’estensione",
				"Per gli strumenti e il contesto che servono al tuo lavoro."
			],
			[
				"Un plugin",
				"Tutto in un repository, che chiunque può aggiungere."
			]
		]
	]
}[locale] as [string, string, string[][]];
const ownPages = ['extend/front-end', 'extend/provider', 'extend/extension', 'reference/plugins'];

const paths = [
	[copy.install, copy.installText, 'start/installation'],
	[copy.learn, copy.learnText, 'guides/sessions'],
	[copy.build, copy.buildText, 'extend/extension'],
];

const software = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'rumbo', description: copy.description, url: new URL(href(locale), Astro.site),
	applicationCategory: 'DeveloperApplication', operatingSystem: 'Linux, macOS', license: 'https://opensource.org/licenses/MIT',
	downloadUrl: `${repository}/releases`, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Site locale={locale} title={copy.title} description={copy.description} next={href(locale, 'start/introduction')}>
	<script type="application/ld+json" set:html={JSON.stringify(software)} />
	<main id="main" class="page">
		<header class="running"><span>rumbo(1)</span><span>{ui.manual}</span><span>rumbo(1)</span></header>

		<p class="head">{ui.heads.name}</p>
		<div class="body">
			<h1>rumbo</h1>
			<p class="lede">{copy.title}. <b>{copy.first} {copy.second}</b></p>
			<pre><code>go install github.com/LiasCode/rumbo/cmd/rumbo@v{release.version}{'\n'}rumbo "{copy.task}"</code></pre>
			<p><a href={href(locale, 'start/quick-start')}>{copy.start} <Icon name="arrow-right" /></a> · <a href={href(locale, 'reference/changelog')}>v{release.version}</a> · Linux / macOS · MIT</p>
		</div>

		<h2 class="head">{ui.heads.synopsis}</h2>
		<div class="body synopsis">
			<p><b>rumbo</b> [<i>flags</i>] [<i>objective</i>]</p>
			<p><b>rumbo -c</b> [<i>objective</i>]</p>
			<p><b>rumbo -r</b></p>
			<p><b>rumbo serve</b> [<i>flags</i>]</p>
			<p><b>rumbo plugin add</b> <i>source</i></p>
		</div>

		<h2 class="head">{ui.heads.description}</h2>
		<p class="body lede">{copy.description}</p>
		<Growth {locale} number={1} />

		<h2 class="head">{ui.heads.examples}</h2>
		<RunTrace {locale} number={2} />
		<div class="body">
			<Compositions {locale} />
		</div>

		<h2 class="head">{yours}</h2>
		<div class="body">
			<p class="lede"><b>{own[0]}.</b> {own[1]}</p>
			<dl class="entries">{own[2].map(([title, detail], index) => <div><dt><a href={href(locale, ownPages[index])}>{title}</a></dt><dd>{detail}</dd></div>)}</dl>
			<pre><code>rumbo plugin add https://github.com/you/your-plugin</code></pre>
			<p><a href="https://github.com/LiasCode/rumbo-claude">rumbo-claude</a> · <a href="https://github.com/LiasCode/rumbo-gui">rumbo-gui</a></p>
		</div>

		<h2 class="head">{ui.heads.seeAlso}</h2>
		<dl class="body entries">{paths.map(([title, detail, path]) => <div><dt><a href={href(locale, path)}>{title}</a></dt><dd>{detail}</dd></div>)}</dl>

		<footer class="running foot"><a href={href(locale, 'reference/changelog')}>rumbo {release.version}</a><span>{release.date}</span><span>rumbo(1)</span></footer>
	</main>
</Site>

<style>
	.synopsis p {
		margin: 0;
		padding-left: 4ch;
		text-indent: -4ch;
	}

</style>
