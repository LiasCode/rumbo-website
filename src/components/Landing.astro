---
import Site from '../layouts/Site.astro';
import Heart from './Heart.astro';
import Growth from './Growth.astro';
import Rule from './Rule.astro';
import Icon from './Icon.astro';
import RunTrace from './RunTrace.astro';
import Compositions from './Compositions.astro';
import { href, type Locale } from '../navigation';
import { repository, release } from '../site.mjs';

const { locale } = Astro.props as { locale: Locale };
const copy = {
	en: { grow: 'Watch it grow', growth: 'From the heart outwards', title: 'A minimal agent harness', first: 'A small core.', second: 'An open system.', caption: 'OPEN SOURCE AGENT HARNESS', description: 'One host orchestrates the work. Choose the interface, connect a model and add the tools you need.', start: 'Get started', pathways: 'Choose your path', install: 'Install and run', installText: 'Linux or macOS. From a release or with Go.', learn: 'Work with rumbo', learnText: 'Sessions, models, settings and scripting.', build: 'Make it yours', buildText: 'Build a provider, interface or extension in any language.', task: 'Summarize this directory without changing files' },
	es: { grow: 'Verlo crecer', growth: 'Del corazón hacia fuera', title: 'Un motor de agentes minimalista', first: 'Un núcleo pequeño.', second: 'Un sistema abierto.', caption: 'MOTOR DE AGENTES DE CÓDIGO ABIERTO', description: 'Un núcleo coordina el trabajo. Elige la interfaz, conecta un modelo y añade las herramientas que necesites.', start: 'Empezar', pathways: 'Elige tu camino', install: 'Instalar y ejecutar', installText: 'Linux o macOS. Desde una versión publicada o con Go.', learn: 'Trabajar con rumbo', learnText: 'Sesiones, modelos, configuración y scripts.', build: 'Hazlo tuyo', buildText: 'Crea un proveedor, una interfaz o una extensión en cualquier lenguaje.', task: 'Summarize this directory without changing files' },
	fr: { grow: 'Le voir grandir', growth: 'Du cœur vers l’extérieur', title: 'Un moteur d’agents minimaliste', first: 'Un petit noyau.', second: 'Un système ouvert.', caption: 'MOTEUR D’AGENTS OPEN SOURCE', description: 'Un noyau orchestre le travail. Choisissez une interface, connectez un modèle et ajoutez les outils nécessaires.', start: 'Commencer', pathways: 'Choisissez votre voie', install: 'Installer et lancer', installText: 'Linux ou macOS. Depuis une version publiée ou avec Go.', learn: 'Travailler avec rumbo', learnText: 'Sessions, modèles, configuration et scripts.', build: 'À votre façon', buildText: 'Créez un fournisseur, une interface ou une extension dans le langage de votre choix.', task: 'Summarize this directory without changing files' },
	it: { grow: 'Guardalo crescere', growth: 'Dal cuore verso l’esterno', title: 'Un motore per agenti minimalista', first: 'Un nucleo piccolo.', second: 'Un sistema aperto.', caption: 'MOTORE PER AGENTI OPEN SOURCE', description: 'Un nucleo coordina il lavoro. Scegli l’interfaccia, collega un modello e aggiungi gli strumenti che ti servono.', start: 'Inizia', pathways: 'Scegli il tuo percorso', install: 'Installa ed esegui', installText: 'Linux o macOS. Da una versione pubblicata o con Go.', learn: 'Lavora con rumbo', learnText: 'Sessioni, modelli, configurazione e script.', build: 'Fallo tuo', buildText: 'Crea un provider, un’interfaccia o un’estensione in qualsiasi linguaggio.', task: 'Summarize this directory without changing files' },
}[locale];

const own = {
	"en": [
		"Make it yours, and share it",
		"rumbo comes with a complete terminal UI and three providers, so it works the day you install it. rumbo-claude and rumbo-gui are there to add if you want them. But the point of rumbo is what you build: write the parts you are missing, in any language, and put them in a Git repository so others can add them with one command.",
		[
			[
				"A front end",
				"For the way you work: your editor, a chat, a web page."
			],
			[
				"A provider",
				"For the model you use, wherever it runs."
			],
			[
				"An extension",
				"For the tools and the context your work needs."
			],
			[
				"A plugin",
				"All of it in one repository, for anyone to add."
			]
		]
	],
	"es": [
		"Hazlo tuyo y compártelo",
		"rumbo trae una interfaz de terminal completa y tres proveedores, así que funciona el día que lo instalas. rumbo-claude y rumbo-gui están ahí para añadirlos si los quieres. Pero lo importante de rumbo es lo que construyes tú: escribe las piezas que te faltan, en cualquier lenguaje, y ponlas en un repositorio Git para que otros las añadan con un comando.",
		[
			[
				"Una interfaz",
				"Para tu forma de trabajar: tu editor, un chat, una web."
			],
			[
				"Un proveedor",
				"Para el modelo que usas, esté donde esté."
			],
			[
				"Una extensión",
				"Para las herramientas y el contexto que necesita tu trabajo."
			],
			[
				"Un plugin",
				"Todo en un repositorio, para que cualquiera lo añada."
			]
		]
	],
	"fr": [
		"Faites-le vôtre, et partagez-le",
		"rumbo apporte une interface en terminal complète et trois fournisseurs : il fonctionne le jour où vous l’installez. rumbo-claude et rumbo-gui sont là si vous voulez les ajouter. Mais l’essentiel de rumbo est ce que vous construisez : écrivez les pièces qui vous manquent, dans n’importe quel langage, et mettez-les dans un dépôt Git pour que d’autres les ajoutent en une commande.",
		[
			[
				"Une interface",
				"Pour votre façon de travailler : votre éditeur, un chat, une page web."
			],
			[
				"Un fournisseur",
				"Pour le modèle que vous utilisez, où qu’il tourne."
			],
			[
				"Une extension",
				"Pour les outils et le contexte dont votre travail a besoin."
			],
			[
				"Un plugin",
				"Le tout dans un dépôt, que chacun peut ajouter."
			]
		]
	],
	"it": [
		"Fallo tuo, e condividilo",
		"rumbo porta un’interfaccia da terminale completa e tre provider: funziona il giorno in cui lo installi. rumbo-claude e rumbo-gui sono lì se vuoi aggiungerli. Ma il punto di rumbo è ciò che costruisci tu: scrivi i pezzi che ti mancano, in qualsiasi linguaggio, e mettili in un repository Git perché altri li aggiungano con un comando.",
		[
			[
				"Un’interfaccia",
				"Per il tuo modo di lavorare: il tuo editor, una chat, una pagina web."
			],
			[
				"Un provider",
				"Per il modello che usi, ovunque giri."
			],
			[
				"Un’estensione",
				"Per gli strumenti e il contesto che servono al tuo lavoro."
			],
			[
				"Un plugin",
				"Tutto in un repository, che chiunque può aggiungere."
			]
		]
	]
}[locale] as [string, string, string[][]];
const ownPages = ['extend/front-end', 'extend/provider', 'extend/extension', 'reference/plugins'];

const paths = [
	[copy.install, copy.installText, 'start/installation'],
	[copy.learn, copy.learnText, 'guides/sessions'],
	[copy.build, copy.buildText, 'extend/extension'],
];

const software = {
	'@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'rumbo', description: copy.description, url: new URL(href(locale), Astro.site),
	applicationCategory: 'DeveloperApplication', operatingSystem: 'Linux, macOS', license: 'https://opensource.org/licenses/MIT',
	downloadUrl: `${repository}/releases`, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Site locale={locale} title={copy.title} description={copy.description}>
	<script type="application/ld+json" set:html={JSON.stringify(software)} />
	<main id="main" class="landing">
		<section class="hero-grid">
			<div class="hero-copy">
				<p class="eyebrow"><span></span>{copy.caption}</p>
				<h1>{copy.first}<br /><em>{copy.second}</em></h1>
				<p class="hero-description">{copy.description}</p>
				<div class="hero-actions"><a class="button solid" href={href(locale, 'start/quick-start')}>{copy.start} <Icon name="arrow-right" /></a><a class="text-link with-icon" href="#growth">{copy.grow} <Icon name="arrow-down" /></a></div>
				<p class="hero-meta"><a href={href(locale, 'reference/changelog')}>v{release.version}</a> <span>·</span> Linux / macOS <span>·</span> MIT</p>
			</div>
			<Heart {locale} />
		</section>
		<section id="growth" class="chapter">
			<Rule seed={1} />
			<div class="section-label" data-seen><span>01 /</span><h2>{copy.growth}</h2></div>
			<Growth {locale} />
		</section>
		<RunTrace {locale} />
		<Compositions {locale} />
		<section id="build" class="chapter">
			<Rule seed={4} />
			<div class="section-label" data-seen><span>04 /</span><h2>{own[0]}</h2></div>
			<p class="own-lead" data-seen>{own[1]}</p>
			<div class="own-grid" data-seen>
				{own[2].map(([title, detail], index) => <a href={href(locale, ownPages[index])}><span class="path-number">0{index + 1}</span><h3>{title}</h3><p>{detail}</p><span class="path-arrow"><Icon name="arrow-up-right" /></span></a>)}
			</div>
			<p class="own-share" data-seen><code>rumbo plugin add https://github.com/you/your-plugin</code><span><a href="https://github.com/LiasCode/rumbo-claude">rumbo-claude</a> · <a href="https://github.com/LiasCode/rumbo-gui">rumbo-gui</a></span></p>
		</section>
		<section class="chapter pathways">
			<Rule seed={5} />
			<div class="section-label" data-seen><span>05 /</span><h2>{copy.pathways}</h2></div>
			<div class="path-grid" data-seen>{paths.map(([title, detail, path], index) => <a href={href(locale, path)}><span class="path-number">0{index + 1}</span><h3>{title}</h3><p>{detail}</p><span class="path-arrow"><Icon name="arrow-up-right" /></span></a>)}</div>
		</section>
		<section class="terminal-strip" aria-label="Terminal" data-seen>
			<span>TERMINAL</span><pre><code><i>$</i> go install github.com/LiasCode/rumbo/cmd/rumbo@v{release.version}{'\n'}<i>$</i> rumbo "{copy.task}"</code></pre>
		</section>
	</main>
</Site>

<script>
	import { reducedMotion } from './timeline';

	// What is marked data-seen arrives as it is scrolled to. The page is
	// only told it moves once this runs, so without a script, or for someone
	// who asked for less motion, everything is simply there.
	if (!reducedMotion.matches) {
		document.documentElement.classList.add('moving');

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('seen');
						observer.unobserve(entry.target);
					}
				}
			},
			{ threshold: 0.2 },
		);

		for (const element of document.querySelectorAll('[data-seen]')) {
			observer.observe(element);
		}
	}
</script>
