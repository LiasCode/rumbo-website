---
import { href, type Locale } from '../navigation';
import Icon from './Icon.astro';

// What the parts make when they are put together: each example is a chain
// of three programs, with the command that sets it up. The commands are
// rumbo 0.13.0's own.
const { locale } = Astro.props as { locale: Locale };

const copy = {
	en: {
		title: 'Chain the parts',
		recipes: [
			['An assistant in your editor', 'Your extension starts a host and draws its events where you write.'],
			['A job in a pipeline', 'No screen: the answer on stdout, the progress on stderr, and an exit code.'],
			['A model on your machine', 'Any server that speaks Chat Completions, through the provider rumbo already has.'],
			['Tools from an MCP server', 'One extension per server; the model gets its tools from the next run.'],
			['A shell that asks first', 'An extension takes the place of bash, and passes on only what it lets through.'],
			['A kit for the whole team', 'Providers, extensions, and skills in one repository, added with one command.'],
		],
	},
	es: {
		title: 'Encadena las piezas',
		recipes: [
			['Un asistente en tu editor', 'Tu extensión arranca un host y dibuja sus eventos donde escribes.'],
			['Una tarea en un pipeline', 'Sin pantalla: la respuesta en stdout, el progreso en stderr y un código de salida.'],
			['Un modelo en tu máquina', 'Cualquier servidor que hable Chat Completions, con el proveedor que rumbo ya trae.'],
			['Herramientas de un servidor MCP', 'Una extensión por servidor; el modelo recibe sus herramientas desde la siguiente ejecución.'],
			['Una shell que pregunta antes', 'Una extensión ocupa el lugar de bash y solo deja pasar lo que acepta.'],
			['Un kit para todo el equipo', 'Proveedores, extensiones y skills en un repositorio, añadidos con un comando.'],
		],
	},
	fr: {
		title: 'Enchaînez les pièces',
		recipes: [
			['Un assistant dans votre éditeur', 'Votre extension lance un hôte et dessine ses événements là où vous écrivez.'],
			['Une tâche dans un pipeline', 'Sans écran : la réponse sur stdout, la progression sur stderr et un code de sortie.'],
			['Un modèle sur votre machine', 'Tout serveur qui parle Chat Completions, avec le fournisseur que rumbo a déjà.'],
			['Les outils d’un serveur MCP', 'Une extension par serveur ; le modèle reçoit ses outils dès l’exécution suivante.'],
			['Un shell qui demande d’abord', 'Une extension prend la place de bash et ne laisse passer que ce qu’elle accepte.'],
			['Un kit pour toute l’équipe', 'Fournisseurs, extensions et skills dans un dépôt, ajoutés en une commande.'],
		],
	},
	it: {
		title: 'Incatena i pezzi',
		recipes: [
			['Un assistente nel tuo editor', 'La tua estensione avvia un host e disegna i suoi eventi dove scrivi.'],
			['Un’attività in una pipeline', 'Senza schermo: la risposta su stdout, l’avanzamento su stderr e un codice di uscita.'],
			['Un modello sulla tua macchina', 'Qualsiasi server che parli Chat Completions, con il provider che rumbo ha già.'],
			['Gli strumenti di un server MCP', 'Un’estensione per server; il modello riceve i suoi strumenti dall’esecuzione successiva.'],
			['Una shell che chiede prima', 'Un’estensione prende il posto di bash e lascia passare solo ciò che accetta.'],
			['Un kit per tutto il team', 'Provider, estensioni e skill in un repository, aggiunti con un comando.'],
		],
	},
}[locale];

const chains = [
	{ links: ['editor', 'rumbo serve', 'provider'], both: true, command: 'rumbo serve -p anthropic', path: 'extend/front-end' },
	{ links: ['CI', 'rumbo -f plain', 'exit 0 · 1 · 130'], both: false, command: 'rumbo "review the diff" > report.md', path: 'guides/scripting' },
	{ links: ['rumbo', 'provide openai', 'localhost:11434'], both: true, command: `rumbo provider add -config '{"base_url":"http://localhost:11434/v1"}' local '{self}' provide openai`, path: 'guides/providers' },
	{ links: ['model', 'extend mcp', 'MCP server'], both: true, command: 'rumbo extension add files {self} extend mcp npx -y @modelcontextprotocol/server-filesystem ~/notes', path: 'guides/extensions' },
	{ links: ['bash call', 'guard.py', 'rumbo’s bash'], both: false, command: 'rumbo extension add -replaces bash guard python3 examples/guard.py', path: 'extend/extension' },
	{ links: ['plugin.yaml', 'git', 'rumbo plugin add'], both: false, command: 'rumbo plugin add <repository>', path: 'guides/plugins' },
];
---

<h3 id="chains">{copy.title}</h3>
<ol class="recipes">
	{chains.map(({ links, both, command, path }, index) => (
		<li>
			<h4><a href={href(locale, path)}>{copy.recipes[index][0]}</a></h4>
			<p class="chain">
				{links.map((link, position) => (
					<>
						{position > 0 && <Icon name={both ? 'arrow-both' : 'arrow-right'} />}
						<span>{link}</span>
					</>
				))}
			</p>
			<p>{copy.recipes[index][1]}</p>
			<pre><code>{command}</code></pre>
		</li>
	))}
</ol>

<style>
	.recipes {
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: recipe;
	}

	.recipes > li {
		position: relative;
		padding-left: 4ch;
		counter-increment: recipe;
	}

	.recipes > li::before {
		content: counter(recipe) '.';
		position: absolute;
		left: 0;
		top: 0;
		color: var(--dim);
	}

	.recipes > li + li {
		margin-top: 1.5lh;
	}

	h4 {
		margin: 0 0 0.3lh;
	}

	/* The chain of programs: each a box, and between them which way the
	   frames go. */
	.chain {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3lh 1ch;
		margin-bottom: 0.5lh;
	}

	.chain span {
		padding: 0 1ch;
		border: 1px solid var(--ink);
		white-space: nowrap;
	}

	.chain :global(.icon) {
		color: var(--dim);
	}
</style>
