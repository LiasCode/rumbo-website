---
import { interfaceCopy, type Locale } from '../navigation';

// The search, as man -k: it filters the index as it is typed, and gives
// each page that matches its description. Enter opens the first one.
const { locale } = Astro.props as { locale: Locale };
const copy = interfaceCopy[locale];
---

<doc-search data-locale={locale} data-empty={copy.empty}>
	<label class="apropos"><span aria-hidden="true">$ man -k</span><input type="search" autocomplete="off" spellcheck="false" placeholder={copy.keys.search} aria-label={copy.search} /></label>
	<p class="search-status" role="status"></p>
</doc-search>

<script>
	type Entry = { locale: string; href: string; title: string; description: string; headings: string[]; commands: string[]; lang: string };

	const normalize = (value: string) => value.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');

	class DocSearch extends HTMLElement {
		connectedCallback() {
			const input = this.querySelector('input')!;
			const status = this.querySelector('[role="status"]')!;
			const nav = this.closest('.index')!.querySelector('nav')!;
			const items = [...nav.querySelectorAll<HTMLElement>('li[data-href]')];
			let pages: Promise<Entry[]> | undefined;

			// Without found, the whole index; with it, only the pages found,
			// each with its description.
			const show = (found?: Map<string, string>) => {
				for (const item of items) {
					const description = found?.get(item.dataset.href!);
					const small = item.querySelector('small')!;

					item.hidden = Boolean(found) && description === undefined;
					small.hidden = !description;
					small.textContent = description ?? '';
				}

				for (const group of nav.querySelectorAll('section')) {
					group.hidden = !group.querySelector('li:not([hidden])');
				}

				status.textContent = found && found.size === 0 ? this.dataset.empty! : '';
			};

			const search = async () => {
				const query = normalize(input.value).trim();
				if (!query) {
					show();
					return;
				}

				pages ??= fetch('/search.json').then(async (response) => {
					if (!response.ok) {
						throw new Error(String(response.status));
					}

					return ((await response.json()) as Entry[]).filter((page) => page.locale === this.dataset.locale);
				});

				try {
					const entries = await pages;
					if (query !== normalize(input.value).trim()) {
						return;
					}

					const words = query.split(/\s+/);
					const found = entries.filter((entry) => {
						const text = normalize([entry.title, entry.href, entry.description, ...entry.headings, ...entry.commands].join(' '));
						return words.every((word) => text.includes(word));
					});

					show(new Map(found.map((entry) => [entry.href, entry.description])));
				} catch {
					pages = undefined;
					status.textContent = this.dataset.empty!;
				}
			};

			input.addEventListener('input', search);
			input.addEventListener('keydown', (event) => {
				if (event.key === 'Enter') {
					event.preventDefault();
					nav.querySelector<HTMLAnchorElement>('li:not([hidden]) a')?.click();
				} else if (event.key === 'Escape') {
					input.value = '';
					show();
					input.blur();
				}
			});
		}
	}

	customElements.define('doc-search', DocSearch);
</script>
