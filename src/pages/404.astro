---
import Site from '../layouts/Site.astro';
import { href, interfaceCopy } from '../navigation';
import { release } from '../site.mjs';

const copy = interfaceCopy.en;
---

<Site locale="en" title="Page not found" description="This page could not be found.">
	<main id="main" class="page">
		<header class="running"><span>rumbo(1)</span><span>{copy.manual}</span><span>rumbo(1)</span></header>
		<p class="head">{copy.heads.name}</p>
		<div class="body">
			<h1>Page not found</h1>
			<p class="lede">{copy.missing}</p>
		</div>
		<h2 class="head">{copy.heads.seeAlso}</h2>
		<dl class="body entries">
			<div><dt><a href={href('en')}>rumbo(1)</a></dt><dd>The front page</dd></div>
			<div><dt><a href={href('en', 'start/introduction')}>What is rumbo?(1)</a></dt><dd>Where the documentation starts</dd></div>
		</dl>
		<footer class="running foot"><span>rumbo {release.version}</span><span>{release.date}</span><span>rumbo(1)</span></footer>
	</main>
</Site>
