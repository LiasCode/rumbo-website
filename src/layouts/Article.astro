---
import type { MarkdownHeading } from 'astro';
import Site from './Site.astro';
import Growth from '../components/Growth.astro';
import Icon from '../components/Icon.astro';
import Flow from '../components/Flow.astro';
import Sequence from '../components/Sequence.astro';
import { href, interfaceCopy, type Locale } from '../navigation';
import type { directory, documents } from '../documents';
import { release } from '../site.mjs';

interface Props {
	locale: Locale;
	doc: Awaited<ReturnType<typeof documents>>[number];
	sidebar: ReturnType<typeof directory>;
	alternates: Locale[];
	headings: MarkdownHeading[];
}

const { locale, doc, sidebar, alternates, headings } = Astro.props;
const { slug, entry, fallback } = doc;
const copy = interfaceCopy[locale];
const { title, description } = entry.data;
const links = sidebar.flatMap(({ items }) => items);
const index = links.findIndex((item) => item.slug === slug);
const group = sidebar.find(({ items }) => items.some((item) => item.slug === slug))!;
const outline = headings.filter(({ depth }) => depth === 2 || depth === 3);
// A first cell this short names its row, and stays on one line; a longer
// one wraps between its words. The styles never break a word of either.
const labelLength = 34;
const article = (await Astro.slots.render('default')).replace(/<tr>\s*<(td|th)([^>]*)>([\s\S]*?)<\/\1>/g, (row, tag, attributes, inner) =>
	inner.replace(/<[^>]+>/g, '').length <= labelLength ? row.replace(`<${tag}${attributes}>`, `<${tag}${attributes} class="label">`) : row,
);

// The articles that open with the frames of a protocol, drawn in motion.
const sequences = ['reference/provider-protocol', 'reference/frontend-protocol', 'reference/extension-protocol', 'reference/plugins', 'extend/provider', 'extend/front-end', 'extend/extension', 'guides/extensions', 'guides/plugins'];
---

<Site {locale} {title} {description} {slug} {alternates} canonicalLocale={fallback ? 'en' : locale}>
	<div class="docs-layout">
		<aside class="docs-sidebar">
			<details class="docs-menu" open>
				<summary>{copy.docs}<Icon name="chevron-down" /></summary>
				<nav aria-label={copy.docs}>
					{sidebar.map(({ label, items }, i) => <section><h2><span>0{i + 1}</span> {label}</h2><ul>{items.map((item) => <li><a lang={item.fallback ? 'en' : locale} href={item.href} aria-current={item.slug === slug ? 'page' : undefined}>{item.title}</a></li>)}</ul></section>)}
				</nav>
			</details>
		</aside>
		<main id="main" class="doc-main">
			<p class="breadcrumb"><a href={href(locale, 'start/introduction')}>{copy.docs}</a><span>/</span>{group.label}<a class="release-tag" href={href(locale, 'reference/changelog')}>{copy.release} {release.version}</a></p>
			{fallback && <p class="translation-note" role="note">{copy.fallback} <a class="with-icon" href={href('en', slug)} lang="en">English <Icon name="arrow-up-right" /></a></p>}
			<article lang={fallback ? 'en' : locale}>
				<header class="article-header"><h1>{title}</h1><p>{description}</p></header>
				{outline.length > 0 && <details class="mobile-outline"><summary>{copy.contents}<Icon name="chevron-down" /></summary><ul>{outline.map(({ depth, slug, text }) => <li class:list={[{ sub: depth === 3 }]}><a href={`#${slug}`}>{text}</a></li>)}</ul></details>}
				{['start/introduction', 'reference/architecture'].includes(slug) && <Growth {locale} compact />}
				{slug === 'start/quick-start' && <Flow {locale} />}
				{sequences.includes(slug) && <Sequence {locale} {slug} />}
				<div class="prose" data-copy={copy.copy} data-copied={copy.copied} set:html={article} />
			</article>
			<nav class="chapter-links" aria-label={copy.docs}>
				{links[index - 1] ? <a href={links[index - 1].href}><small><Icon name="arrow-left" />{copy.prev}</small><span lang={links[index - 1].fallback ? 'en' : locale}>{links[index - 1].title}</span></a> : <span />}
				{links[index + 1] ? <a href={links[index + 1].href}><small>{copy.next}<Icon name="arrow-right" /></small><span lang={links[index + 1].fallback ? 'en' : locale}>{links[index + 1].title}</span></a> : <span />}
			</nav>
		</main>
		{outline.length > 0 && <aside class="doc-outline"><nav aria-label={copy.contents}><p>{copy.contents}</p><ul lang={fallback ? 'en' : locale}>{outline.map(({ depth, slug, text }) => <li class:list={[{ sub: depth === 3 }]}><a href={`#${slug}`}>{text}</a></li>)}</ul></nav></aside>}
	</div>
	<template id="copy-button"><button type="button" class="button small"><Icon name="copy" class="when-off" /><Icon name="check" class="when-on" /><span data-label>{copy.copy}</span></button></template>
</Site>

<script>
	const menu = document.querySelector<HTMLDetailsElement>('.docs-menu')!;
	const desktop = matchMedia('(min-width: 64rem)');
	const setMenu = () => { menu.open = desktop.matches; };
	setMenu();
	desktop.addEventListener('change', setMenu);

	const prose = document.querySelector<HTMLElement>('.prose')!;
	const template = document.querySelector<HTMLTemplateElement>('#copy-button')!;
	for (const pre of prose.querySelectorAll('pre')) {
		const code = pre.querySelector('code');
		if (!code || !navigator.clipboard) {
			continue;
		}

		const frame = document.createElement('div');
		frame.className = 'code-frame night';
		pre.before(frame);
		frame.append(pre);

		const button = template.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
		const label = button.querySelector('[data-label]')!;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(code.textContent!.trimEnd());
				button.dataset.on = '';
				label.textContent = prose.dataset.copied!;
				setTimeout(() => {
					delete button.dataset.on;
					label.textContent = prose.dataset.copy!;
				}, 1500);
			} catch {
				button.hidden = true;
			}
		});
		frame.append(button);
	}
</script>
